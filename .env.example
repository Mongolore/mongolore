# Copy to .env.local and fill in. Restart `npm run dev` after editing.
# Never put real keys in this file — it is committed to git.

# Login / sign-up and synced progress. Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only admin key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: better English translations with Claude. Without it the MN/EN
# button uses free Google Translate.
ANTHROPIC_API_KEY=

# Only for `npm run db:setup` / `npm run db:check`. Supabase → Connect → connection string.
SUPABASE_CONNECTION_STRING=
